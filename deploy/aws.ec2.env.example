POSTGRES_DB=researchlanka
POSTGRES_USER=researchlanka_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433

AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-admin-password
RESEARCHLANKA_ADMIN_API_TOKEN=replace-with-output-of-openssl-rand-base64-48
# Keep false while serving the EC2 app over plain HTTP/IP.
# Set true after putting the app behind HTTPS.
AUTH_COOKIE_SECURE=false

FRONTEND_PORT=3000

RESEARCHLANKA_SEMANTIC_EMBEDDINGS_PATH=data/models/publication_text_embeddings_cli_sample.parquet
RESEARCHLANKA_SEMANTIC_MODEL_PATH=data/models/publication_text_embedding_model_cli_sample.joblib
RESEARCHLANKA_AI_RELEVANCE_MODEL_MANIFEST_PATH=configurations/ai_relevance_model_manifest.json
RESEARCHLANKA_INCREMENTAL_STATE_BACKEND=database
RESEARCHLANKA_INCREMENTAL_STATE_KEY=openalex_incremental
OPENALEX_EMAIL=you@example.com

# Optional reviewer accounts, configured as email|id|display name and separated
# by commas. Keep real account identifiers in deployment secrets, not in Git.
AI_REVIEWER_ACCOUNTS=

# Google Sheets export. Store the JSON key on EC2 only; never commit it.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_HOST_FILE=./secrets/google_sheets_service_account.json
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=/run/secrets/google_sheets_service_account.json
