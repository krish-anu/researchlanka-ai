# Copy to `.env` at the repo root and fill real values.
# `.env` is gitignored — never commit passwords.

# Live deployed frontend
RESEARCHLANKA_DEPLOYED_BASE_URL=http://YOUR_EC2_HOST:3000
RESEARCHLANKA_DEPLOYED_API_BASE_URL=http://YOUR_EC2_HOST:3000/api/v1

# Test accounts used by Phase 3 live login checks
RESEARCHLANKA_TEST_ADMIN_EMAIL=
RESEARCHLANKA_TEST_ADMIN_PASSWORD=
RESEARCHLANKA_TEST_USER_NAME=
RESEARCHLANKA_TEST_USER_EMAIL=
RESEARCHLANKA_TEST_USER_PASSWORD=

# Real common-dataset CSV for Phase 2/3 in-process API tests
RESEARCHLANKA_USE_REAL_DATASET=1
RESEARCHLANKA_TEST_DATASET_PATH=data/processed/common/common_publications_final.csv

# Optional direct database (only if reachable from your machine)
# DATABASE_URL=postgresql://researchlanka_user:PASSWORD@HOST:5432/researchlanka
