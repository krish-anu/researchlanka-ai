{
  "name": "researchlanka-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Public read-only frontend for the ResearchLanka national research analytics platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint-no-debug.mjs && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "check:palette": "node scripts/check-series-contrast.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.6",
    "cytoscape": "^3.34.3",
    "next": "^16.3.6",
    "plotly.js-dist-min": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
