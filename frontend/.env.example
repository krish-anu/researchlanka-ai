# Base URL of the read-only ResearchLanka API (backend/src/api/server.py).
# Start it with:  cd backend && python -m src.api.server --port 8080
API_BASE_URL=http://127.0.0.1:8080/api/v1

# Optional. Only needed if you want the browser to call the API directly
# instead of going through this app's server-side fetches / rewrite proxy.
# Leave unset for the default same-origin proxy behaviour.
# NEXT_PUBLIC_API_BASE_URL=
