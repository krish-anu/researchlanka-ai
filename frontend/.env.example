# Base URL of the read-only ResearchLanka API (backend/src/api/server.py).
# Start it with:  cd backend && python -m src.api.server --port 8080
API_BASE_URL=http://127.0.0.1:8080/api/v1

# Optional. Only needed if you want the browser to call the API directly
# instead of going through this app's server-side fetches / rewrite proxy.
# Leave unset for the default same-origin proxy behaviour.
# NEXT_PUBLIC_API_BASE_URL=

# --- Accounts and roles -----------------------------------------------------
# HMAC key for the session cookie. Must be >= 32 characters in production;
# rotating it signs every existing session out.
#   openssl rand -base64 48
AUTH_SECRET=

# The first administrator, created on first run when no accounts exist.
# Leave unset in development and a dev pair is seeded, with the password
# printed once to the server log.
ADMIN_EMAIL=admin@example.com   
ADMIN_PASSWORD=password123

# Where accounts, saved libraries, flags and the review queue are written.
# Defaults to ./.data — see src/services/store/jsonFile.ts for the caveats.
# APP_DATA_DIR=
