{
  "country": {
    "name": "Sri Lanka",
    "code": "LK"
  },
  "coverage": {
    "start_year": 2000,
    "end_year": 2026
  },
  "project": {
    "name": "Sri Lankan Research Analytics",
    "country_name": "Sri Lanka",
    "country_code": "LK",
    "dashboard_title": "Sri Lankan Research Overview"
  },
  "input": {
    "path": "data/processed/repositories_combined.csv",
    "format": "csv",
    "source_name": "sri_lanka_repository_dataset"
  },
  "source": {
    "name": "sri_lanka_repository_dataset",
    "type": "csv",
    "path": "data/processed/repositories_combined.csv",
    "delimiter": ",",
    "encoding": "utf-8",
    "adapter_version": "1.0",
    "mapping_version": "1.0"
  },
  "collection": {
    "start_year": 2010,
    "end_year": 2026,
    "batch_size": 200,
    "retry_limit": 3,
    "request_delay_seconds": 1
  },
  "institution_registry": {
    "path": "configurations/sri_lanka/institutions.csv"
  },
  "sources": {
    "openalex": {
      "enabled": true,
      "options": {
        "strict_country_only": true
      }
    },
    "crossref": {
      "enabled": true
    },
    "national_journal_portal": {
      "enabled": true,
      "name": "SLJOL"
    },
    "university_repositories": {
      "enabled": true
    }
  },
  "pipeline": {
    "collect": true,
    "transform": true,
    "validate": true,
    "clean": true,
    "enrich": false,
    "deduplicate": true,
    "resolve_entities": false,
    "load_database": false,
    "run_analytics": true,
    "export": true,
    "classify": false,
    "topic_modeling": false,
    "semantic_search": false,
    "forecasting": false
  },
  "column_mapping": {
    "source_institution_id": "institutions",
    "source_record_id": "source_record_id",
    "title": "title",
    "authors": "authors",
    "abstract": "abstract",
    "keywords": "keywords",
    "publication_date": "publication_date",
    "publication_year": "publication_year",
    "publication_type": "publication_type",
    "publisher": "publisher",
    "journal": "journal",
    "language": "language",
    "doi": "doi",
    "url": "source_url"
  },
  "transformations": {
    "publication_year": {
      "type": "extract_year"
    },
    "authors": {
      "type": "split",
      "separator": ";"
    },
    "keywords": {
      "type": "split",
      "separator": ";"
    },
    "doi": {
      "type": "normalize_doi"
    }
  },
  "validation": {
    "required": ["title"],
    "require_any": ["doi", "authors", "publication_year", "source_record_id"]
  },
  "cleaning": {
    "normalize_doi": true,
    "normalize_title": true,
    "normalize_author_names": true,
    "normalize_institutions": true,
    "valid_year": {
      "minimum": 1950,
      "maximum": 2026
    },
    "required_fields": ["title"],
    "optional_fields": ["doi", "abstract", "keywords"]
  },
  "deduplication": {
    "enabled": true,
    "doi_match": {
      "enabled": true,
      "automatic_merge": true
    },
    "exact_title_match": {
      "enabled": true,
      "require_same_year": true
    },
    "fuzzy_title_match": {
      "enabled": false,
      "threshold": 90
    },
    "author_match": {
      "minimum_matching_authors": 1
    },
    "year_difference": {
      "maximum": 1
    },
    "uncertain_matches": {
      "send_to_manual_review": true
    }
  },
  "categories": [
    "Computer Science",
    "Engineering",
    "Medicine",
    "Agriculture",
    "Social Sciences",
    "Business",
    "Natural Sciences"
  ],
  "publication_types": [
    "journal-article",
    "conference-paper",
    "book-chapter",
    "thesis",
    "report"
  ],
  "analytics": {
    "citation_analysis": true,
    "collaboration_analysis": true,
    "topic_analysis": true,
    "trend_analysis": true,
    "semantic_search": true
  },
  "export": {
    "output_dir": "outputs/sri_lanka",
    "formats": ["csv", "json"]
  }
}
