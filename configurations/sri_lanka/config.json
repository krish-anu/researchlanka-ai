{
  "country": {
    "name": "Sri Lanka",
    "code": "LK"
  },
  "coverage": {
    "start_year": 2000,
    "end_year": 2026
  },
  "project": {
    "name": "ResearchLanka National Research Analytics",
    "dashboard_title": "Sri Lanka National Research Portal"
  },
  "institution_registry": {
    "path": "configurations/sri_lanka/institutions.csv"
  },
  "input": {
    "path": "data/processed/repositories_combined.csv",
    "format": "csv",
    "source_name": "sri_lanka_repositories"
  },
  "source": {
    "name": "sri_lanka_repositories",
    "type": "csv",
    "path": "data/processed/repositories_combined.csv",
    "delimiter": ",",
    "encoding": "utf-8"
  },
  "collection": {
    "batch_size": 200,
    "retry_limit": 3,
    "request_delay_seconds": 1.0
  },
  "pipeline": {
    "collect": true,
    "transform": true,
    "validate": true,
    "clean": true,
    "deduplicate": true,
    "resolve_entities": true,
    "load_database": false,
    "run_analytics": true,
    "export": true,
    "classify": false,
    "topic_modeling": false
  },
  "column_mapping": {
    "source_record_id": "source_record_id",
    "doi": "doi",
    "title": "title",
    "abstract": "abstract",
    "publication_year": "publication_year",
    "publication_date": "publication_date",
    "publication_type": "publication_type",
    "language": "language",
    "journal": "journal",
    "publisher": "publisher",
    "authors": "authors",
    "keywords": "keywords",
    "url": "source_url"
  },
  "transformations": {
    "publication_year": {
      "type": "extract_year"
    },
    "authors": {
      "type": "split",
      "separator": ";"
    },
    "keywords": {
      "type": "split",
      "separator": ";"
    },
    "doi": {
      "type": "normalize_doi"
    }
  },
  "validation": {
    "required": [
      "title"
    ],
    "require_any": [
      "doi",
      "authors",
      "publication_year",
      "source_record_id"
    ]
  },
  "cleaning": {
    "normalize_doi": true,
    "normalize_title": true,
    "normalize_author_names": true,
    "normalize_institutions": true,
    "valid_year": {
      "minimum": 2000,
      "maximum": 2026
    },
    "required_fields": [
      "title"
    ],
    "optional_fields": [
      "doi",
      "abstract",
      "keywords"
    ]
  },
  "deduplication": {
    "enabled": true,
    "doi_match": {
      "enabled": true,
      "automatic_merge": true
    },
    "exact_title_match": {
      "enabled": true,
      "require_same_year": true
    },
    "fuzzy_title_match": {
      "enabled": false,
      "threshold": 90
    },
    "author_match": {
      "minimum_matching_authors": 1
    },
    "year_difference": {
      "maximum": 1
    },
    "uncertain_matches": {
      "send_to_manual_review": true
    }
  },
  "categories": [
    "Engineering",
    "Medicine",
    "Social Sciences",
    "Natural Sciences",
    "Humanities"
  ],
  "publication_types": [
    "journal-article",
    "conference-paper",
    "book-chapter",
    "thesis",
    "report"
  ],
  "analytics": {
    "citation_analysis": true,
    "collaboration_analysis": true,
    "topic_analysis": true,
    "trend_analysis": true
  },
  "dashboard": {
    "title": "Sri Lanka National Research Portal",
    "export_formats": [
      "csv",
      "json"
    ]
  },
  "export": {
    "output_dir": "outputs/sri_lanka",
    "formats": [
      "csv",
      "json"
    ]
  }
}
