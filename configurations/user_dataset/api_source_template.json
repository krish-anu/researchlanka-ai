{
  "source": {
    "name": "example_api",
    "type": "api",
    "base_url": "https://example.org/api/publications",
    "method": "GET",
    "headers": {},
    "authentication": {
      "type": "api_key",
      "header_name": "X-API-Key",
      "environment_variable": "EXAMPLE_API_KEY"
    },
    "pagination": {
      "type": "page",
      "page_parameter": "page",
      "page_size_parameter": "limit",
      "page_size": 100,
      "next_page_path": "meta.next_page"
    },
    "response": {
      "records_path": "data.publications"
    },
    "adapter_version": "1.0",
    "mapping_version": "1.0"
  },
  "column_mapping": {
    "id": "source_record_id",
    "paperTitle": "title",
    "creatorNames": "authors",
    "yearPublished": "publication_year"
  },
  "transformations": {
    "publication_year": {
      "type": "extract_year"
    },
    "authors": {
      "type": "split",
      "separator": ";"
    }
  },
  "validation": {
    "required": ["title"],
    "require_any": ["doi", "authors", "publication_year", "source_record_id"]
  }
}
