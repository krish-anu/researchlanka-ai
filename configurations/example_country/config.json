{
  "country": {
    "name": "Example Country",
    "code": "EX"
  },
  "coverage": {
    "start_year": 2015,
    "end_year": 2026
  },
  "project": {
    "name": "Example Country Research Analytics",
    "country_name": "Example Country",
    "country_code": "EX",
    "dashboard_title": "Example Country Research Overview"
  },
  "input": {
    "path": "examples/sample_publications.csv",
    "format": "csv",
    "source_name": "example_country_dataset"
  },
  "source": {
    "name": "example_country_dataset",
    "type": "csv",
    "path": "examples/sample_publications.csv",
    "delimiter": ",",
    "encoding": "utf-8",
    "adapter_version": "1.0",
    "mapping_version": "1.0"
  },
  "collection": {
    "start_year": 2015,
    "end_year": 2026,
    "batch_size": 100,
    "retry_limit": 3,
    "request_delay_seconds": 1
  },
  "institution_registry": {
    "path": "configurations/example_country/institutions.csv"
  },
  "pipeline": {
    "collect": true,
    "transform": true,
    "validate": true,
    "clean": true,
    "enrich": false,
    "deduplicate": true,
    "resolve_entities": false,
    "load_database": false,
    "run_analytics": true,
    "export": true
  },
  "column_mapping": {
    "paper_name": "title",
    "researcher": "authors",
    "university": "institutions",
    "published_year": "publication_year",
    "record_id": "source_record_id",
    "countries": "countries"
  },
  "transformations": {
    "publication_year": {
      "type": "extract_year"
    },
    "authors": {
      "type": "split",
      "separator": ";"
    },
    "keywords": {
      "type": "split",
      "separator": ";"
    },
    "countries": {
      "type": "split",
      "separator": ";"
    },
    "doi": {
      "type": "normalize_doi"
    }
  },
  "validation": {
    "required": ["title"],
    "require_any": ["doi", "authors", "publication_year", "source_record_id"]
  },
  "cleaning": {
    "normalize_doi": true,
    "normalize_title": true,
    "normalize_author_names": true,
    "normalize_institutions": true,
    "valid_year": {
      "minimum": 1950,
      "maximum": 2026
    },
    "required_fields": ["title"],
    "optional_fields": ["doi", "abstract", "keywords"]
  },
  "deduplication": {
    "enabled": true,
    "doi_match": {
      "enabled": true,
      "automatic_merge": true
    },
    "exact_title_match": {
      "enabled": true,
      "require_same_year": true
    }
  },
  "categories": [
    "Engineering",
    "Medicine",
    "Education",
    "Social Sciences"
  ],
  "publication_types": [
    "journal-article",
    "conference-paper",
    "book-chapter",
    "thesis",
    "report"
  ],
  "analytics": {
    "citation_analysis": true,
    "collaboration_analysis": true,
    "topic_analysis": true,
    "trend_analysis": true,
    "semantic_search": false
  },
  "export": {
    "output_dir": "outputs/example_country",
    "formats": ["csv", "json"]
  }
}
